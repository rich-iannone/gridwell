      </tr>
    </thead>
    <tbody>
      <tr>
        <td headers="col_0">underline</td>
        <td class="gw_style-u" headers="col_1">Underlined</td>
      </tr>
      <tr>
        <td headers="col_0">line-through</td>
        <td class="gw_style-s" headers="col_1">Struck out</td>
      </tr>
      <tr>
        <td headers="col_0">18px</td>
        <td class="gw_style-big" headers="col_1">Larger text</td>
      </tr>
      <tr>
        <td headers="col_0">smaller</td>
        <td class="gw_style-small" headers="col_1">Smaller text</td>
      </tr>
      <tr>
        <td headers="col_0">inline</td>
        <td headers="col_1">
          Plain, <span class="gw_style-u">underlined</span>, <span class="gw_style-s">struck</span> and <span class="gw_style-big">large</span>
        </td>
      </tr>
    </tbody>
  </table>
