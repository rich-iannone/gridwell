    .gw_style-small { font-size: smaller }
    .gw_style-u { text-decoration: underline }
  </style>
  <table class="gw_table">
    <thead>
      <tr class="gw_col_labels">
        <th class="gw_col_label gw__al_left">Format</th>
        <th class="gw_col_label gw__al_left">Sample</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>underline</td>
        <td class="gw_style-u">Underlined</td>
      </tr>
      <tr>
        <td>line-through</td>
        <td class="gw_style-s">Struck out</td>
      </tr>
