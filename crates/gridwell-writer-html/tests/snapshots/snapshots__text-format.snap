        <td>18px</td>
        <td class="gw_style-big">Larger text</td>
      </tr>
      <tr>
        <td>smaller</td>
        <td class="gw_style-small">Smaller text</td>
      </tr>
      <tr>
        <td>inline</td>
        <td>
