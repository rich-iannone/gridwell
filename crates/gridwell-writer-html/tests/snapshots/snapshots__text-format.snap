    .gw_style-small { font-size: smaller }
    .gw_style-u { text-decoration: underline }
  </style>
  <table class="gw_table">
    <thead>
      <tr class="gw_col_labels">
        <th class="gw_col_label gw__al_left" id="col_0">Format</th>
