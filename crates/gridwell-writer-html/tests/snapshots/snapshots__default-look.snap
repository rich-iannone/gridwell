---
source: crates/gridwell-writer-html/tests/snapshots.rs
expression: render_html(&ex.table()).unwrap()
---
<div class="gw_container">
  <style>
    :where(.gw_container) { font-family: system-ui, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #333333; font-size: 16px; line-height: normal; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; width: fit-content; max-width: 100%; margin-left: auto; margin-right: auto }
    :where(.gw_title:first-of-type, .gw_subtitle:first-of-type, .gw_header_line:first-of-type) { border-top: 2px solid #A8A8A8 }
    :where(.gw_title) { font-size: 125%; text-align: center; padding: 4px 5px }
    :where(.gw_subtitle) { font-size: 85%; text-align: center; padding: 3px 5px 5px }
    :where(.gw_header_line) { font-size: 85%; text-align: center; padding: 0 5px 5px }
    :where(.gw_table) { border-collapse: collapse; margin: 0; width: 100%; border-top: 2px solid #D3D3D3; border-bottom: 2px solid #D3D3D3 }
    :where(.gw_cells_top) { border-top: none }
    :where(.gw_cells_bottom) { border-bottom: none }
    :where(.gw_table td, .gw_table th) { padding: 8px 5px; border-top: 1px solid #D3D3D3 }
    :where(.gw_table > tbody:first-of-type > tr:first-child > *) { border-top: none }
    :where(.gw_table th) { font-weight: inherit }
    :where(.gw_table thead th) { border-top: none; padding: 5px 5px 6px }
    :where(.gw_table thead tr) { vertical-align: bottom }
    :where(.gw_table thead) { border-bottom: 2px solid #D3D3D3 }
    :where(.gw_table thead:last-child) { border-bottom: none }
    :where(.gw_cells_head thead) { border-bottom: none }
    :where(.gw_spanner) { padding: 5px 4px 7px; background-image: linear-gradient(#D3D3D3, #D3D3D3); background-size: calc(100% - 8px) 2px; background-position: bottom center; background-repeat: no-repeat }
    :where(.gw_spanner:first-child) { padding-left: 0; background-size: calc(100% - 4px) 2px; background-position: bottom left }
    :where(.gw_spanner:last-child) { padding-right: 0; background-size: calc(100% - 4px) 2px; background-position: bottom right }
    :where(.gw_spanner:first-child:last-child) { background-size: 100% 2px }
    :where(.gw_group_label) { border-top: 2px solid #D3D3D3; border-bottom: 2px solid #D3D3D3 }
    :where(.gw_stub) { border-right: 2px solid #D3D3D3 }
    :where(tbody > tr.gw_summary:first-child > *, tr:not(.gw_summary) + tr.gw_summary > *) { border-top: 2px solid #D3D3D3 }
    :where(tbody > tr.gw_grand_summary:first-child:not(.gw_summary_top) > *, tr:not(.gw_grand_summary) + tr.gw_grand_summary:not(.gw_summary_top) > *) { border-top: 6px double #D3D3D3 }
    :where(tr.gw_summary_end > *) { border-bottom: 2px solid #D3D3D3 }
    :where(tr.gw_grand_summary.gw_summary_end > *) { border-bottom: 6px double #D3D3D3 }
    :where(.gw_rule_top) { border-top: 2px solid #D3D3D3 }
    :where(thead .gw_rule_head) { border-bottom: 2px solid #D3D3D3 }
    :where(tbody .gw_rule_head) { border-top: 2px solid #D3D3D3 }
    :where(.gw_rule_bottom) { border-bottom: 2px solid #D3D3D3 }
    :where(.gw_table tbody .gw__al_right) { font-variant-numeric: tabular-nums }
    :where(.gw_footer) { border-bottom: 2px solid #A8A8A8 }
    :where(.gw_footnote, .gw_source_note) { margin: 0; font-size: 90%; padding: 4px 5px }
    :where(.gw_footnote_mark) { font-size: 75%; vertical-align: 0.4em; line-height: 0; font-style: italic }
    :where(.gw_footnote_mark a) { color: inherit; text-decoration: none }
    .gw_table .gw__al_left { text-align: left }
    .gw_table .gw__al_right { text-align: right }
    .gw_style-total { font-weight: bold; background-color: #F5F5F5 }
    .gw_table .gw__c0 { background-color: rgba(128, 128, 128, 0.051) }
  </style>
  <div class="gw_title" id="title" role="heading" aria-level="1">
    Quarterly P&amp;L
  </div>
  <table class="gw_table" aria-labelledby="title">
    <thead>
      <tr class="gw_col_labels">
        <th class="gw_stubhead gw__al_left" id="Line-item">Line item</th>
        <th class="gw_col_label gw__al_right" id="col_1">Q1</th>
        <th class="gw_col_label gw__al_right" id="col_2">Q2</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th class="gw_stub gw__al_left" scope="row" id="stub-1">Revenue</th>
        <td class="gw__al_right" headers="stub-1 col_1">$1,200</td>
        <td class="gw__al_right" headers="stub-1 col_2">$1,350</td>
      </tr>
      <tr>
        <th class="gw_stub gw__al_left" scope="row" id="stub-2">COGS</th>
        <td class="gw__al_right gw__c0" headers="stub-2 col_1">$700</td>
        <td class="gw__al_right gw__c0" headers="stub-2 col_2">$760</td>
      </tr>
      <tr>
        <th class="gw_stub gw__al_left" scope="row" id="stub-3">Opex</th>
        <td class="gw__al_right" headers="stub-3 col_1">$300</td>
        <td class="gw__al_right" headers="stub-3 col_2">$320</td>
      </tr>
      <tr class="gw_summary">
        <th class="gw_stub gw__al_left gw_style-total" scope="row" id="summary-Net-income">Net income</th>
        <td class="gw__al_right gw_style-total" headers="summary-Net-income col_1">$200</td>
        <td class="gw__al_right gw_style-total" headers="summary-Net-income col_2">$270</td>
      </tr>
    </tbody>
  </table>
  <div class="gw_footer">
    <div class="gw_source_notes">
      <p class="gw_source_note">
        Unaudited management figures.
      </p>
    </div>
  </div>
</div>
