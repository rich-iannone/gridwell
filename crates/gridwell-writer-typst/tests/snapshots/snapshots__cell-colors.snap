    table.hline(stroke: 0.5pt),
  ),
  [Fire],
  table.cell(fill: rgb("#C0392B"))[#text(fill: rgb("#FFFFFF"))[hot]],
  [Ice],
  table.cell(fill: rgb("#2980B9"))[#text(fill: rgb("#FFFFFF"))[cold]],
)
